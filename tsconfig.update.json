{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-update",
    "rootDir": ".",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src-update/**/*.ts", "src-main/updater-core.ts"],
  "exclude": ["**/*.test.ts", "src-main/test-utils.ts"]
}
