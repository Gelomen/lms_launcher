{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-main",
    "rootDir": "src-main",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src-main/**/*.ts"],
  "exclude": ["src-main/**/*.test.ts", "src-main/test-utils.ts"]
}
